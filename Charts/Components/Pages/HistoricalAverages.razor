@using Server.Models
<div class="metric-list">
    <div class="metric-row">
        <span class="metric-label">Mean Daily Maximum</span>
        <span class="metric-value">@Data.MaxTemp.ToString("F1") °C</span>
    </div>
    <div class="metric-row">
        <span class="metric-label">Daily Mean</span>
        <span class="metric-value">@Data.MeanTemp.ToString("F1") °C</span>
    </div>
    <div class="metric-row">
        <span class="metric-label">Mean Daily Minimum</span>
        <span class="metric-value">@Data.MinTemp.ToString("F1") °C</span>
    </div>
    <div class="metric-row">
        <span class="metric-label">Precipitation</span>
        <span class="metric-value">@Data.Precipitation.ToString("F1") mm</span>
    </div>
    <div class="metric-row">
        <span class="metric-label">Sunshine Hours</span>
        <span class="metric-value">@Data.SunshineHours.ToString("F1") hours</span>
    </div>
    <div class="metric-row">
        <span class="metric-label">Record High</span>
        <span class="metric-value">@Data.RecordHigh.ToString("F1")°C (@Data.RecordHighYear)</span>
    </div>
    <div class="metric-row">
        <span class="metric-label">Record Low</span>
        <span class="metric-value">@Data.RecordLow.ToString("F1")°C (@Data.RecordLowYear)</span>
    </div>
</div>

@code {
    [Parameter] public WeatherDataModel Data { get; set; }
}
