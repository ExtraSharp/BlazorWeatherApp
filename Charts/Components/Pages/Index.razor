@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender:false))
@using Syncfusion.Blazor.DropDowns

<PageTitle>Blazor Weather App</PageTitle>

<div class="page-shell">
    <header class="page-header">
        <div class="page-title">
            <span class="eyebrow">Blazor Weather</span>
            <h1>Germany Weather Overview</h1>
            <p>Live conditions, historical averages, and monthly trends.</p>
        </div>
        <div class="page-status">
            <span class="status-label">Station</span>
            <span class="status-value">@State.StationDisplayName</span>
            <span class="status-subtitle">Last updated @State.LastUpdatedTime</span>
        </div>
    </header>

    <section class="card filters-card">
        <div class="filters-grid">
            <div class="field">
                <label class="field-label">Station</label>
                <div class="control-wrapper">
                    <SfComboBox TValue="string" TItem="WeatherStationOption" Placeholder="Select a station" DataSource="@State.StationData" Enabled="@(!State.IsBusy && !State.IsStationsLoading)">
                        <ComboBoxEvents TValue="string" TItem="WeatherStationOption" ValueChange="OnChange" />
                        <ComboBoxFieldSettings Value="Id" Text="Text"></ComboBoxFieldSettings>
                    </SfComboBox>
                </div>
            </div>
            <div class="field">
                <label class="field-label">Latitude</label>
                <input class="text-input" type="text" @bind="State.Latitude" disabled="@State.IsBusy" aria-label="Latitude" placeholder="Latitude" pattern="-?\d+(\.\d*)?" oninput="this.value = this.value.replace(/[^0-9\.-]/g, '');">
            </div>
            <div class="field">
                <label class="field-label">Longitude</label>
                <input class="text-input" type="text" @bind="State.Longitude" disabled="@State.IsBusy" aria-label="Longitude" placeholder="Longitude" pattern="-?\d+(\.\d*)?" oninput="this.value = this.value.replace(/[^0-9\.-]/g, '');">
            </div>
            <div class="field actions-field">
                <label class="field-label">Actions</label>
                @if (State.DisplayRefreshIcon)
                {
                    <button @onclick="RefreshData" type="button" class="btn btn-primary refresh-button" aria-label="Refresh" disabled="@State.IsBusy">&#x21bb;</button>
                }
                else
                {
                    <button @onclick="RefreshData" type="button" class="btn btn-primary refresh-button" disabled="@State.IsBusy">@(State.IsRefreshing ? "Refreshing..." : "Refresh")</button>
                }
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(State.ErrorMessage))
        {
            <div class="inline-alert">@State.ErrorMessage</div>
        }
    </section>

    <section class="section-grid">
        <div class="card">
            <h3>Current Weather</h3>
            <CurrentWeather CurrentWeatherData="State.CurrentWeather" Temperature="@State.Temperature" DewPoint="@State.DewPoint" Humidity="@State.Humidity" CloudCover="@State.CloudCover" Icon="@State.Icon" LastUpdatedTime="@State.LastUpdatedTime" />
        </div>

        <div class="card">
            <h3>Historical Data for @TodayLabel</h3>
            <HistoricalAverages Data="@State.HistoricalAverages"></HistoricalAverages>
        </div>
    </section>

    <section class="card chart-card">
        <div class="card-header">
            <h3>Climate Chart for @State.StationDisplayName</h3>
        </div>
        <div class="chart-body">
            @if (!string.IsNullOrWhiteSpace(State.ClimateErrorMessage))
            {
                <span class="chart-error">@State.ClimateErrorMessage</span>
            }
            else if (State.HeatMapData == null)
            {
                <span class="chart-loading">Loading climate data...</span>
            }
            else
            {
                <div class="heatmap-wrapper">
                    <HeatMap HeatMapData="@State.HeatMapData" TextOverflow="@State.TextOverflow" FontSize="@State.DataLabelFontSize" />
                </div>
            }
        </div>
    </section>

    <section class="card chart-card">
        <div class="card-header">
            <div>
                <h3>Mean Temperatures and Precipitation</h3>
                <span class="card-subtitle">@State.SelectedMonthLabel</span>
            </div>
            <div class="month-nav">
                <button class="btn btn-outline" type="button" @onclick="() => ChangeMonth(-1)" disabled="@State.IsBusy">Previous</button>
                <button class="btn btn-outline" type="button" @onclick="() => ChangeMonth(1)" disabled="@State.IsBusy">Next</button>
            </div>
        </div>
        <div class="chart-body">
            <WeatherChart Temperatures="@State.Temperatures" Width="@State.Width" @rendermode="@RenderMode.InteractiveServer" />
        </div>
    </section>
</div>
